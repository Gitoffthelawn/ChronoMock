      "file": "age-of-majority.json",
      "id": "age-of-majority",
      "applies_to": "calculator",
      "market": null,
      "calendar": null,
      "name": {
        "en": "Age-of-majority boundary",
        "pl": "Granica pełnoletności"
      },
      "explains": {
        "en": "Does the app apply the age-of-majority boundary correctly - admitting someone exactly on their 18th birthday, and refusing them the day before?",
        "pl": "Czy aplikacja poprawnie stosuje granicę pełnoletności - dopuszcza kogoś dokładnie w 18. urodziny i odmawia dzień wcześniej?"
      },
      "time_mode": {
        "multiplier": 1,
        "scale_duration_clock": false
      },
      "parameters": [
        {
          "id": "birth_date",
          "type": "date",
          "label": {
            "en": "Date of birth",
            "pl": "Data urodzenia"
          },
          "default": null,
          "default_hint": null
        },
        {
          "id": "boundary",
          "type": "variant",
          "label": {
            "en": "Day to test",
            "pl": "Dzień do sprawdzenia"
          },
          "default": "day_before",
          "default_hint": null,
          "choices": [
            {
              "label": "day_before",
              "days": -1
            },
            {
              "label": "on_day",
              "days": 0
            },
            {
              "label": "day_after",
              "days": 1
            }
          ]
        }
      ],
      "moment": {
        "base": {
          "kind": "parameter",
          "parameter": "birth_date"
        },
        "steps": [
          {
            "kind": "shift",
            "sign": "+",
            "amount": 18,
            "unit": "y"
          },
          {
            "kind": "shift",
            "parameter": "boundary"
          }
        ]
      }
    },
